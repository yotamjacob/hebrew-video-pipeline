# Python environment & cache
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Whisper model cache (~1.5 GB)
models/

# Pipeline outputs & temp dirs
*_edited.mp4
output.mp4
hebpipe_*/
tmp/

# Test/sample video files (large binaries)
input_vids/

# Images (binary, not useful to read)
img/
site/img/

# Vercel metadata
site/.vercel/

# Secrets
.env
.envrc

# Node / test tooling (regenerable)
node_modules/
playwright-report/
test-results/
.pytest_cache/
package-lock.json

# Test fixtures & media (binary)
tests/frontend/fixtures/
podcast-site/img/
exports/
*.mp4
*.webp

# Committed snapshot data (generated by generate_stats.py, don't read directly)
site/stats.json
