<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Parallel multipart upload to presigned R2 URLs. dataSync type is
             required on Android 14+ for a foreground service that transfers
             files; the matching permission is declared below. -->
        <service
            android:name=".ParallelUploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 9 and older require this to save into public Downloads.
         Android 10+ uses scoped storage and does not request it. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Background upload (@capgo/capacitor-uploader) runs a foreground service so
         a video keeps uploading when the app is minimized. Android 14+ requires a
         typed foreground-service permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- ParallelUploadService holds a partial wake lock while parts stream so
         a dozing CPU can't stall an in-flight upload. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Single haptic nudge when an upload finishes (navigator.vibrate). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+ requires this for "your video is ready" push notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The app has NO ads and never reads the advertising ID, but the Firebase
         messaging dependency injects these permissions "for Privacy Sandbox
         support". Strip them so the bundle matches our Play declaration
         ("Does your app use advertising ID?" = No). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />
</manifest>
