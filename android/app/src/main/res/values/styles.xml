<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Always-LIGHT: the web UI has no dark mode (warm sand design), so a dark
         window/WebView would flash black around it in system dark mode. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Android 15+ (targetSdk 35+) is edge-to-edge: Capacitor's SystemBars
             plugin pads the WebView below the status bar and paints that strip
             with windowBackground - which was the AppCompat Light default
             (white). Sand keeps it continuous with the app header. -->
        <item name="android:windowBackground">#E8DFD3</item>
        <!-- Status bar (Android 14 and below): brand sand with DARK icons.
             Without windowLightStatusBar the bar was white with white icons -
             clock/battery invisible. -->
        <item name="android:statusBarColor">#E8DFD3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#E8DFD3</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ system splash: sand brand background instead of the
             theme default (which went BLACK in dark mode). -->
        <item name="windowSplashScreenBackground">#E8DFD3</item>
        <!-- No icon on the system splash: the scaled launcher icon rendered
             soft and clashed with the in-app brand loader. A plain sand flash
             (~0.5s, the OS minimum) flows straight into the animated loader. -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- Same bar treatment during launch so there is no white flash. -->
        <item name="android:statusBarColor">#E8DFD3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#E8DFD3</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>