# Hebrew Video Pipeline — environment variables
# Copy to .env and fill in your keys

# Anthropic (Claude) — for stock B-roll moment selection
ANTHROPIC_API_KEY=...
# Pexels — free video API — https://www.pexels.com/api/
PEXELS_API_KEY=...

# Pixabay — free video API — https://pixabay.com/api/docs/
PIXABAY_API_KEY=...
# Google Gemini — for Veo video generation (optional, Veo currently disabled)
GEMINI_API_KEY=...

# Feature flags
VEO_ENABLED=false
