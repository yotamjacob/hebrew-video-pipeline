<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "Video is ready" pushes (@capacitor/push-notifications + FCM, the same
	     backend _send_fcm path Android uses). Xcode's automatic signing swaps
	     this to "production" for App Store/TestFlight builds; the value here is
	     what a local device build uses.
	     In-app purchase deliberately has NO entitlement key - it is enabled on
	     the App ID in the developer portal and nowhere else. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
