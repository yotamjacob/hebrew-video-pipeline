<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<!-- Stays "en" because the permission purpose strings below are the English
	     fallback that every unlocalized device falls back to. Adding
	     he.lproj/InfoPlist.strings in Xcode later localizes them; see
	     APPLE_RELEASE.md. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- Launcher label. Hebrew on purpose, matching the Android launcher
	     (strings.xml) - the App Store listing name is the English/ASCII one. -->
	<key>CFBundleDisplayName</key>
	<string>פייפליין</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- The app ships a full Hebrew + English UI (site/i18n.js). Declaring both
	     is what makes the App Store list them as supported languages. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>he</string>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Export compliance: the app uses only standard HTTPS/TLS, which is
	     exempt. Setting this here means every TestFlight/App Store upload skips
	     the encryption questionnaire instead of blocking the build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Picking the source video. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pipeline needs access to your photo library so you can choose a video to edit.</string>
	<!-- Saving the finished video back to the camera roll. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Pipeline saves your finished video to your photo library.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- The design system is a fixed warm-sand light theme. Without this, iOS
	     dark mode renders WHITE status-bar icons over the sand background - the
	     exact invisible-clock bug that had to be fixed on Android (styles.xml,
	     2026-07-14) - and flips WebView prefers-color-scheme under the app. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
